<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF5F5F5">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/custom_navbar">
            <!--여기가 메인 홈 화면-->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="top"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/custom_navbar">
                <!--캐칭 앱 로고와 이름-->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="#FFF5F5F5">
                    <ImageView
                        android:layout_margin="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_catching"/>
                    <ImageView
                        android:layout_margin="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/name_catching_mint"/>
                </LinearLayout>

                <!--캐칭 앱 배너 광고-->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/banner_catching_background">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:background="#17212121">
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="20dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/banner_catching_title">
                        </ImageView>
                    </FrameLayout>
                </RelativeLayout>

                <include
                    layout="@layout/inapp_notification_banner" />

                <!--공지사항-->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <!--공지사항문구-->
                    <LinearLayout
                        android:id="@+id/home_notice_go"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_marginTop="7dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="공지사항"
                            android:fontFamily="@font/medium"
                            android:textSize="18sp"
                            android:textColor="#FF2DD7A4"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"/>
                    </LinearLayout>
                    <!--공지사항 내용-->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="7dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:rippleColor="@android:color/transparent"
                        android:backgroundTint="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:padding="3dp"
                            android:background="#FFFFFF">
                            <TextView
                                android:id="@+id/home_notice_preview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF808080"
                                android:textSize="15sp"
                                android:lineSpacingExtra="4dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                            <!-- 내용 -->
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
                <!--학사공지-->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <!--공지사항문구-->
                    <LinearLayout
                        android:id="@+id/home_school_go"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_marginTop="7dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="학사공지"
                            android:fontFamily="@font/medium"
                            android:textSize="18sp"
                            android:textColor="#FF2DD7A4"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"/>
                    </LinearLayout>
                    <!--학사공지 내용-->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="7dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:backgroundTint="@android:color/white">

                        <LinearLayout
                            android:id="@+id/home_school_preview_layout"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/school_preview_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF808080"
                                android:textSize="15sp"
                                android:paddingBottom="10dp"
                                android:lineSpacingExtra="4dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxLines="1"/>

                            <TextView
                                android:id="@+id/school_preview_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF808080"
                                android:textSize="15sp"
                                android:paddingBottom="10dp"
                                android:lineSpacingExtra="4dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxLines="1"/>

                            <TextView
                                android:id="@+id/school_preview_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF808080"
                                android:textSize="15sp"
                                android:paddingBottom="10dp"
                                android:lineSpacingExtra="4dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!--fragment 뜨면 터치 차단용-->
        <View
            android:id="@+id/touch_blocker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!--매칭 페이지 선택시 카테고리창 fragment영역-->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--하단 navBar-->
        <include
            android:id="@+id/custom_navbar"
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom"/>
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>