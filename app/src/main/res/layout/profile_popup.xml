<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ✅ 카드 팝업 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_profile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:contentDescription="닫기"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/profile_popup_roomate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/btn_close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!--이름 & 프로필 사진-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_marginBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_profile_reverse"/>
                    <TextView
                        android:id="@+id/roommate_name"
                        android:text="김국민"
                        android:textSize="18sp"
                        android:fontFamily="@font/regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!--특징-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- 특징 태그 묶음 -->
                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="8dp"
                        app:flexWrap="wrap"
                        app:justifyContent="center">

                        <TextView
                            android:id="@+id/roommate_gender"
                            android:text="남"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/roommate_dormitory"
                            android:text="교내생활관"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/roommate_age"
                            android:text="2005년생"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/roommate_mbti"
                            android:text="ESFP"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/roommate_drink"
                            android:text="음주 O"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/roommate_smoke"
                            android:text="흡연 X"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/roommate_time"
                            android:text="00:00 ~ 08:00"
                            android:textSize="16sp"
                            android:fontFamily="@font/light"
                            android:background="@drawable/background_card_tag"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </com.google.android.flexbox.FlexboxLayout>

                    <!-- 특징 percent (제목 → 숫자+바 같은 줄) -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_margin="0dp"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- 청결도 -->
                        <TextView
                            android:text="청결도"
                            android:textSize="16sp"
                            android:textColor="#FF2DD7A4"
                            android:fontFamily="@font/semibold"
                            android:layout_marginBottom="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp">

                            <!-- 숫자 -->
                            <TextView
                                android:id="@+id/roommate_clean_value"
                                android:text="5"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2DD7A4"
                                android:layout_marginEnd="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <!-- 바 -->
                            <SeekBar
                                android:id="@+id/roommate_clean_seekbar"
                                android:layout_width="225dp"
                                android:layout_height="wrap_content"
                                android:max="10"
                                android:min="0"
                                android:progress="5"
                                android:thumb="@drawable/thumb"
                                android:progressDrawable="@drawable/custom_seekbar_progress"
                                android:splitTrack="false"
                                android:thumbOffset="0dp"/>
                        </LinearLayout>


                        <!-- 잠꼬대 -->
                        <TextView
                            android:text="잠꼬대"
                            android:textSize="16sp"
                            android:textColor="#FF2DD7A4"
                            android:fontFamily="@font/semibold"
                            android:layout_marginBottom="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp">

                            <TextView
                                android:id="@+id/roommate_sleep_value"
                                android:text="5"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2DD7A4"
                                android:layout_marginEnd="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <SeekBar
                                android:id="@+id/roommate_sleep_seekbar"
                                android:layout_width="225dp"
                                android:layout_height="wrap_content"
                                android:max="10"
                                android:min="0"
                                android:progress="5"
                                android:thumb="@drawable/thumb"
                                android:progressDrawable="@drawable/custom_seekbar_progress"
                                android:splitTrack="false"
                                android:thumbOffset="0dp"/>
                        </LinearLayout>


                        <!-- 예민도 -->
                        <TextView
                            android:text="예민도"
                            android:textSize="16sp"
                            android:textColor="#FF2DD7A4"
                            android:fontFamily="@font/semibold"
                            android:layout_marginBottom="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/roommate_sensitive_value"
                                android:text="5"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2DD7A4"
                                android:layout_marginEnd="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <SeekBar
                                android:id="@+id/roommate_sensitive_seekbar"
                                android:layout_width="225dp"
                                android:layout_height="wrap_content"
                                android:max="10"
                                android:min="0"
                                android:progress="5"
                                android:thumb="@drawable/thumb"
                                android:progressDrawable="@drawable/custom_seekbar_progress"
                                android:splitTrack="false"
                                android:thumbOffset="0dp"/>
                        </LinearLayout>

                    </LinearLayout>




                </LinearLayout>
            </LinearLayout>

            <!-- 버튼 -->
            <LinearLayout
                android:id="@+id/layout_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/profile_popup_roomate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ✅ 수락 버튼 (텍스트 위에 겹침) -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:id="@+id/btn_accept"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_accept"
                        android:contentDescription="수락" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="수락하기"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </FrameLayout>

                <!-- ✅ 거절 버튼 (텍스트 위에 겹침) -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:id="@+id/btn_reject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_decline"
                        android:contentDescription="거절" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="거절하기"
                        android:textColor="#F44336"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </FrameLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>