<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white">
    <LinearLayout
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white">
        <View
            android:layout_width="5dp"
            android:layout_height="1dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_margin="10dp"/>
        <ImageView
            android:id="@+id/login_agree_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_left"
            android:layout_margin="10dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Title Container -->

            <!-- Confirm Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/title_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="개인정보 수집·이용에 대한 동의"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="■ 수집·이용 항목"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="닉네임, 카카오톡 ID, 이메일, MBTI, 성별, 기숙사 종류, 출생년도, 음주 여부, 흡연 여부, 전공 학과, 팀플 경험, 청결도, 잠꼬대 정도, 예민 정도" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="■ 수집·이용 목적"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="회원 식별 및 기본 서비스 제공\n고객 문의 및 민원 처리\n매칭 알고리즘 개발 및 사용자 맞춤형 추천 제공\n신규 서비스 개발 및 품질 향상" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="■ 보유 및 이용 기간"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="회원 탈퇴 시 즉시 파기\n단, 법령에 따라 보관이 필요한 정보는 해당 기간 동안 보관 후 파기" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="※ 귀하는 개인정보 수집·이용에 동의하지 않을 권리가 있습니다. 단, 필수 항목 거부 시 서비스 이용이 제한될 수 있습니다."
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="※ 만 14세 미만의 경우 법정대리인 동의가 필요합니다."
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="※ 본 동의서에 동의 시 개인정보처리방침 내용을 이해한 것으로 간주합니다."
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="■ 개인정보 보호책임자"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="이름: 조승윤\n이메일: seungyoonjo05@kookmin.ac.kr" />
                <!-- 서비스 이용약관 토글 -->
                <LinearLayout
                    android:id="@+id/privacy_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/terms_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="▶ 서비스 이용약관 보기"
                        android:textSize="15dp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 약관 본문 컨테이너 (초기 숨김) -->
                <LinearLayout
                    android:id="@+id/terms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/terms_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="서비스 이용약관\n
\n
본 약관은 팀 캐칭(이하 “서비스 제공자”)이 제공하는 기숙사 매칭 서비스(이하 “서비스”)의\n
이용 조건 및 절차, 서비스 제공자와 회원 간의 권리·의무, 책임사항 등을 규정함을 목적으로 합니다.\n
\n
제1조 (목적)\n
본 약관은 서비스 제공자가 제공하는 서비스 이용과 관련하여\n
회원과 서비스 제공자 간의 권리·의무 및 책임사항을 규정합니다.\n
\n
제2조 (정의)\n
1. “서비스”란 서비스 제공자가 운영하는 기숙사 룸메이트 매칭 서비스 일체를 의미합니다.\n
2. “회원”이란 본 약관에 동의하고 서비스 이용 계약을 체결한 자를 말합니다.\n
3. “콘텐츠”란 회원이 서비스 내에서 입력하거나 게시하는 모든 정보 및 자료를 의미합니다.\n
\n
제3조 (약관의 효력 및 변경)\n
1. 본 약관은 회원이 서비스 가입 시 동의함으로써 효력이 발생합니다.\n
2. 서비스 제공자는 관련 법령에 위배되지 않는 범위에서 약관을 변경할 수 있습니다.\n
3. 변경된 약관은 사전 공지를 통해 안내하며, 변경 사항에 동의하지 않을 경우 회원은 탈퇴할 수 있습니다.\n
\n
제4조 (서비스의 제공 및 변경)\n
서비스 제공자는 다음과 같은 서비스를 제공합니다.\n
1. 기숙사 룸메이트 매칭 기능\n
2. 사용자 프로필 기반 추천 기능\n
3. 기타 서비스 제공자가 개발하여 제공하는 부가 서비스\n
\n
운영상 필요한 경우 서비스의 일부 또는 전체를 변경하거나 중단할 수 있으며,\n
이 경우 사전 공지를 원칙으로 합니다.\n
\n
제5조 (회원의 의무)\n
회원은 다음의 행위를 해서는 안 됩니다.\n
1. 허위 정보 등록\n
2. 타인의 개인정보 도용\n
3. 욕설·비방·음란·불법 정보 게시\n
4. 서비스 운영을 방해하는 행위\n
5. 승인되지 않은 방식으로 서비스 이용\n
\n
제6조 (서비스 제공자의 의무)\n
1. 서비스 제공자는 안정적인 서비스 제공을 위해 최선을 다합니다.\n
2. 서비스 제공자는 회원의 개인정보를 개인정보보호법 등 관련 법령에 따라 안전하게 처리합니다.\n
\n
제7조 (서비스 이용의 제한)\n
회원이 본 약관을 위반하거나 서비스 질서를 심각하게 훼손하는 경우\n
서비스 제공자는 경고, 이용 제한, 강제 탈퇴 등의 조치를 취할 수 있습니다.\n
\n
제8조 (책임의 제한)\n
1. 서비스 제공자는 회원 간 매칭 결과에 대한 어떠한 책임도 지지 않습니다.\n
2. 서비스 제공자는 개인 간 분쟁에 개입하지 않으며 이에 따른 손해에 대해 책임지지 않습니다.\n
3. 천재지변, 시스템 오류 등 불가항력적 사유로 발생한 손해에 대해 책임을 지지 않습니다.\n
\n
제9조 (게시물의 관리)\n
회원이 게시한 콘텐츠가 관련 법령 또는 서비스 운영정책을 위반하는 경우\n
서비스 제공자는 삭제, 차단 등의 조치를 취할 수 있습니다.\n
\n
제10조 (이용계약의 종료)\n
1. 회원은 언제든지 탈퇴할 수 있으며 탈퇴 시 대부분의 개인정보는 즉시 삭제됩니다(법령 보관 제외).\n
2. 서비스 제공자는 약관 위반 시 이용계약을 해지할 수 있습니다.\n
\n
제11조 (준거법)\n
본 약관은 대한민국 법령을 따릅니다.\n
\n
사용자 정보 공개 안내\n
본 서비스는 정확한 매칭을 위해 회원이 입력한 일부 정보가 다른 사용자에게 공개될 수 있습니다.\n
공개되는 정보는 다음과 같습니다:\n
- 닉네임\n
- 성별\n
- MBTI\n
- 기숙사 종류\n
- 매칭에 필수적인 최소 정보\n
\n
연락처, 카카오톡 ID 등 민감한 정보는\n
회원의 명시적 동의 없이는 어떤 사용자에게도 제공되지 않습니다.\n
\n
개인정보 보호책임자 정보\n
서비스 제공자: 팀 캐칭 (개발자 조승윤 외 팀원)\n
개인정보 보호책임자: 조승윤\n
이메일: seungyoonjo05@kookmin.ac.kr"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Checkboxes -->
                <CheckBox
                    android:id="@+id/agree_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(필수) 개인정보 수집 동의 "
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/agree_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="(필수) 고지사항 확인"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/privacy_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="동의서 버전: 1.0"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_submit_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="확인 및 동의 완료"
                android:textColor="@android:color/white"
                android:background="#D93636"
                android:layout_marginTop="40dp"
                android:padding="12dp"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

    </ScrollView>
</LinearLayout>

